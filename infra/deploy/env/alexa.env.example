# Simulated Alexa+ (/alexa), production. /opt/nightshift/env/alexa.env (chmod 600).
# NIGHTSHIFT_MCP_URL, NIGHTSHIFT_DEPLOY_URL, DEMO_ADMIN_URL and SECURE_COOKIES are set in
# infra/docker-compose.prod.yml. No AWS keys here: Bedrock and Polly use the EC2 instance role.

ALLOWED_ORIGINS=https://__DOMAIN__
ALLOWED_HOSTS=__DOMAIN__

# Bedrock + Polly are required in production (the container refuses to start otherwise).
MODEL_PROVIDER=bedrock
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
AWS_REGION=ap-southeast-2
# The guardrail id from `aws bedrock list-guardrails` (empty = no guardrail).
BEDROCK_GUARDRAIL_ID=
# Published version (set together with the id).
BEDROCK_GUARDRAIL_VERSION=
TTS_PROVIDER=polly
CLOUDWATCH_METRICS=true

# Cost guards (defaults shown).
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_MINUTES=10
DAILY_MODEL_REQUEST_CAP=100
DAILY_SPEECH_REQUEST_CAP=300
DAILY_SPEECH_CHAR_CAP=40000

# Demo controls: same value as in demo.env (generated by bootstrap.sh).
DEMO_ADMIN_TOKEN=__DEMO_ADMIN_TOKEN__
# For the bad deploy scenario: an ingest token (npm run token:new -- alexa-sim ingest on your
# laptop; its sha256 entry goes in nightshift.env NIGHTSHIFT_INGEST_TOKENS).
NIGHTSHIFT_INGEST_TOKEN=
