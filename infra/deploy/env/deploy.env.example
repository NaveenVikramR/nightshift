# How infra/deploy/up.sh gets images. /opt/nightshift/env/deploy.env (chmod 600).
# Set to pull the images GitHub Actions builds (.github/workflows/images.yml), e.g.
#   NIGHTSHIFT_IMAGE_PREFIX=ghcr.io/<github-owner-lowercase>/nightshift
# Empty = build everything on this host (slow; needs the 2 GB swap for the Next.js build).
NIGHTSHIFT_IMAGE_PREFIX=
NIGHTSHIFT_IMAGE_TAG=main
