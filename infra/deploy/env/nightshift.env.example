# Nightshift server, production. Lives at /opt/nightshift/env/nightshift.env (chmod 600).
# bootstrap.sh fills __DOMAIN__ and generates the random secrets; you fill the empty ones.
# HOST, PORT, NIGHTSHIFT_CONFIG and TRUST_PROXY are set in infra/docker-compose.prod.yml.

# Public hostname (DNS-rebinding guard, Origin allowlist, and the security scan target).
# "nightshift" is the in-network name Alertmanager uses for the webhook (Caddy only serves
# the public domain, so outside clients can't reach it with that Host).
ALLOWED_HOSTS=__DOMAIN__,nightshift
ALLOWED_ORIGINS=https://__DOMAIN__
SECURITY_DOMAIN=__DOMAIN__

# API clients: ONLY sha256 hashes. Create each token on your laptop with
#   npm run token:new -- <actor> <viewer|responder>
# keep the printed plaintext token, and paste the JSON entries here as one array, e.g.
# [{"actor":"naveen","role":"responder","sha256":"…"},{"actor":"judge","role":"viewer","sha256":"…"}]
NIGHTSHIFT_TOKENS=
# CI deploy reporters (optional): npm run token:new -- <source> ingest
NIGHTSHIFT_INGEST_TOKENS=[]

# Neon: a NEW branch or database for prod. Pooled URL (host has "-pooler") and direct URL.
DATABASE_URL=
DIRECT_URL=

# Generated by bootstrap.sh. DEMO_ADMIN_TOKEN is the same value as in demo.env.
DEMO_ADMIN_TOKEN=__DEMO_ADMIN_TOKEN__
ALERTMANAGER_WEBHOOK_TOKEN=__WEBHOOK_TOKEN__

# Telegram bot from @BotFather, and your chat id (message the bot, then open
# https://api.telegram.org/bot<token>/getUpdates on your laptop to read chat.id).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: fine-grained read-only GitHub token for Dependabot / secret-scanning checks.
GITHUB_TOKEN=

# Voice clients may reconnect between "shall I?" and "yes"; keep false (see .env.example).
STRICT_SESSION_BINDING=false
