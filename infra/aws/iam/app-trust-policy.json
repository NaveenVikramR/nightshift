{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LaptopViaSignInRole",
      "Effect": "Allow",
      "Principal": { "AWS": "arn:aws:iam::ACCOUNT_ID:role/managed/AccountFullAccessRole" },
      "Action": "sts:AssumeRole"
    },
    {
      "Sid": "LaterEc2InstanceProfile",
      "Effect": "Allow",
      "Principal": { "Service": "ec2.amazonaws.com" },
      "Action": "sts:AssumeRole"
    }
  ]
}
