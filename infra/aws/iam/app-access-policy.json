{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "NovaLiteConverseSydney",
      "Effect": "Allow",
      "Action": ["bedrock:InvokeModel", "bedrock:InvokeModelWithResponseStream"],
      "Resource": "arn:aws:bedrock:ap-southeast-2::foundation-model/amazon.nova-lite-v1:0"
    },
    {
      "Sid": "GuardrailsSydney",
      "Effect": "Allow",
      "Action": "bedrock:ApplyGuardrail",
      "Resource": "arn:aws:bedrock:ap-southeast-2:ACCOUNT_ID:guardrail/*"
    },
    {
      "Sid": "PollySydney",
      "Effect": "Allow",
      "Action": "polly:SynthesizeSpeech",
      "Resource": "*",
      "Condition": { "StringEquals": { "aws:RequestedRegion": "ap-southeast-2" } }
    },
    {
      "Sid": "NightshiftMetricsOnly",
      "Effect": "Allow",
      "Action": "cloudwatch:PutMetricData",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "cloudwatch:namespace": "Nightshift",
          "aws:RequestedRegion": "ap-southeast-2"
        }
      }
    }
  ]
}
