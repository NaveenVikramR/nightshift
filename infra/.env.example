# Copy to infra/.env (gitignored). Read by docker compose and the chaos scripts.

# Bearer token for the demo-target admin API (chaos switches). At least 16 chars.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
DEMO_ADMIN_TOKEN=

# Host port for demo-target (inside Docker it listens on 8080). 18080 avoids the
# common clash with local web servers on 8080.
DEMO_TARGET_PORT=18080

# Where the chaos scripts reach demo-target.
DEMO_TARGET_URL=http://127.0.0.1:18080
