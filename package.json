{
  "name": "nightshift",
  "version": "0.1.0",
  "private": true,
  "description": "Nightshift: voice on-call and security copilot exposed as an MCP server for Alexa+ and other MCP clients.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "workspaces": [
    "apps/server",
    "apps/demo-target"
  ],
  "scripts": {
    "dev": "npm run dev -w @nightshift/server",
    "start": "npm run start -w @nightshift/server",
    "build": "npm run build -w @nightshift/server",
    "test": "npm test --workspaces --if-present && node --test \"infra/scripts/*.test.mjs\"",
    "test:integration": "npm run test:integration -w @nightshift/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seed": "npm run seed -w @nightshift/server",
    "token:new": "npm run token:new -w @nightshift/server",
    "stack:up": "node infra/scripts/ensure-secrets.mjs && docker compose -f infra/docker-compose.yml up -d --build --wait",
    "stack:down": "docker compose -f infra/docker-compose.yml down",
    "stack:logs": "docker compose -f infra/docker-compose.yml logs -f --tail=100",
    "stack:check": "node infra/scripts/check-config.mjs",
    "stack:status": "node infra/scripts/stack-status.mjs",
    "chaos:provider_outage": "node infra/scripts/chaos.mjs provider_outage",
    "chaos:latency_spike": "node infra/scripts/chaos.mjs latency_spike",
    "chaos:auth_bruteforce": "node infra/scripts/chaos.mjs auth_bruteforce",
    "chaos:webhook_spoofing": "node infra/scripts/chaos.mjs webhook_spoofing",
    "chaos:bad_deploy": "node infra/scripts/chaos.mjs bad_deploy",
    "chaos:security_weak": "node infra/scripts/chaos.mjs security weak",
    "chaos:security_harden": "node infra/scripts/chaos.mjs security hardened",
    "chaos:failover": "node infra/scripts/chaos.mjs route-provider stripe",
    "chaos:state": "node infra/scripts/chaos.mjs state",
    "chaos:reset": "node infra/scripts/chaos.mjs reset"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
