# Simulated Alexa+ (apps/alexa-sim). Copy to .env.local for `npm run dev -w @nightshift/alexa-sim`.
# In production these live in /opt/nightshift/env/alexa.env (see infra/deploy/env/).
# No AWS keys here, ever: Bedrock and Polly use the AWS SDK default credential chain
# (the EC2 instance role in prod, your AWS profile locally).

# Nightshift MCP endpoint (in-network in prod: http://nightshift:3000/mcp).
NIGHTSHIFT_MCP_URL=http://127.0.0.1:3000/mcp

# Exact Origins / Host headers accepted by the API routes. Empty = local dev
# (http://127.0.0.1:3002, http://localhost:3002). Prod: https://<domain> and <domain>.
ALLOWED_ORIGINS=
ALLOWED_HOSTS=
# true in prod (HTTPS): the session cookie gets the Secure flag.
SECURE_COOKIES=false

# Model: "scripted" (local, no AWS) or "bedrock" (Converse API with tool use).
MODEL_PROVIDER=scripted
BEDROCK_MODEL_ID=
AWS_REGION=
# Speech: "browser" (local speechSynthesis) or "polly" (neural voices, MP3).
TTS_PROVIDER=browser

# Guardrails (defaults shown).
MAX_TOOL_CALLS_PER_TURN=6
MAX_TURNS_PER_SESSION=40
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_MINUTES=10
DAILY_MODEL_REQUEST_CAP=500
DAILY_SPEECH_REQUEST_CAP=1500
MODEL_TIMEOUT_MS=20000
MCP_TIMEOUT_MS=35000
TURN_TIMEOUT_MS=60000
SESSION_IDLE_MINUTES=30

# Demo controls (responder only). Server-side only; never sent to the browser.
# Local: demo-target on 18080, token = DEMO_ADMIN_TOKEN from infra/.env.
DEMO_ADMIN_URL=http://127.0.0.1:18080
DEMO_ADMIN_TOKEN=
# bad_deploy reports its deploy to Nightshift like CI (an ingest token; npm run token:new -- alexa-sim ingest).
NIGHTSHIFT_DEPLOY_URL=http://127.0.0.1:3000
NIGHTSHIFT_INGEST_TOKEN=
