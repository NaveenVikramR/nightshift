# Simulated Alexa+ (apps/alexa-sim). Copy to .env.local for `npm run dev -w @nightshift/alexa-sim`.
# In production these live in /opt/nightshift/env/alexa.env (see infra/deploy/env/).
# No AWS keys here, ever: Bedrock and Polly use the AWS SDK default credential chain
# (the EC2 instance role in prod; locally `aws login --profile nightshift`, then start with
# AWS_PROFILE=nightshift-app, the least-privilege app role, see infra/aws/README.md).
# The server refuses to start if the settings or credentials are missing: no silent fallback.

# Nightshift MCP endpoint (in-network in prod: http://nightshift:3000/mcp).
NIGHTSHIFT_MCP_URL=http://127.0.0.1:3000/mcp

# Exact Origins / Host headers accepted by the API routes. Empty = local dev
# (http://127.0.0.1:3002, http://localhost:3002). Prod: https://<domain> and <domain>.
ALLOWED_ORIGINS=
ALLOWED_HOSTS=
# true in prod (HTTPS): the session cookie gets the Secure flag.
SECURE_COOKIES=false

# Model: Amazon Bedrock Converse with tool use. Nova Lite runs on-demand in ap-southeast-2.
MODEL_PROVIDER=bedrock
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
AWS_REGION=ap-southeast-2
# Bedrock guardrail (prompt-attack filter on the person's words and on outside text in tool
# results). Both or neither. Created once: infra/aws/guardrail.json.
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=
# Speech: Amazon Polly neural (Kajal en-IN, Joanna en-US).
TTS_PROVIDER=polly
# CloudWatch custom metrics (namespace Nightshift, 5 counts, free tier).
CLOUDWATCH_METRICS=true
# Tests / local scripted e2e only (refused when NODE_ENV=production):
# MODEL_PROVIDER=scripted TTS_PROVIDER=browser ALLOW_SCRIPTED_MODEL=true
ALLOW_SCRIPTED_MODEL=false

# Guardrails (defaults shown).
MAX_TOOL_CALLS_PER_TURN=6
MAX_TURNS_PER_SESSION=40
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_MINUTES=10
DAILY_MODEL_REQUEST_CAP=100
DAILY_SPEECH_REQUEST_CAP=300
DAILY_SPEECH_CHAR_CAP=40000
MODEL_TIMEOUT_MS=20000
MCP_TIMEOUT_MS=35000
TURN_TIMEOUT_MS=60000
SESSION_IDLE_MINUTES=30

# Demo controls (responder only). Server-side only; never sent to the browser.
# Local: demo-target on 18080, token = DEMO_ADMIN_TOKEN from infra/.env.
DEMO_ADMIN_URL=http://127.0.0.1:18080
DEMO_ADMIN_TOKEN=
# bad_deploy reports its deploy to Nightshift like CI (an ingest token; npm run token:new -- alexa-sim ingest).
NIGHTSHIFT_DEPLOY_URL=http://127.0.0.1:3000
NIGHTSHIFT_INGEST_TOKEN=
