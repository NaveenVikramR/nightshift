# Nightshift MCP server configuration.
# Copy to apps/server/.env and fill in. Never commit .env (it is gitignored).
# Every value is read once at startup by src/config.ts.

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------

# Interface to bind. Keep 127.0.0.1 for local use (MCP spec: local servers
# SHOULD bind to localhost only). Use 0.0.0.0 only behind a hosting proxy.
HOST=127.0.0.1

# Port to listen on.
PORT=3000

# Comma-separated list of exact browser origins (scheme://host[:port]) allowed
# to call /mcp. A request WITH an Origin header not in this list gets 403.
# Requests without an Origin header (CLI clients, server-to-server) are allowed
# through to bearer-token auth. Leave empty to reject every request that sends
# an Origin header.
# Example (MCP Inspector default UI port): http://localhost:6274
ALLOWED_ORIGINS=http://localhost:6274,http://127.0.0.1:6274

# Comma-separated Host header values accepted (DNS-rebinding protection).
# Defaults to localhost, 127.0.0.1 and [::1] when empty. A non-empty list REPLACES
# those defaults, so keep them when adding a host. With the local Docker stack:
#   ALLOWED_HOSTS=localhost,127.0.0.1,[::1],host.docker.internal
# When deployed, add your public hostname, e.g. nightshift.example.com
ALLOWED_HOSTS=

# Set to true ONLY when running behind exactly one reverse proxy / load
# balancer (e.g. App Runner), so the client IP is read from X-Forwarded-For.
# Used by the failed-auth rate limiter. Leave false for local use.
TRUST_PROXY=false

# confirm_action normally requires the same actor (token), the same params and an
# unexpired, unused confirmation. Set true to ALSO require the same MCP session.
# Stricter, but voice clients that reconnect between "do it?" and "yes" get refused.
STRICT_SESSION_BINDING=false

# Maximum JSON body size accepted on POST /mcp. Larger bodies get 413.
MCP_MAX_BODY_BYTES=1048576

# ---------------------------------------------------------------------------
# Sessions (kept IN MEMORY: run exactly one server instance)
# ---------------------------------------------------------------------------

# Idle time after which an MCP session is discarded; later requests with that
# MCP-Session-Id get 404 and the client must re-initialize.
SESSION_IDLE_TTL_MINUTES=30

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------

# JSON array of API clients. Only SHA-256 hashes of tokens are stored here.
# Generate an entry with:  npm run token:new -- <actor> <viewer|responder>
# It prints the plaintext token ONCE (give it to the client) and the JSON
# entry to paste here.
# Example: [{"actor":"alice","role":"responder","sha256":"<64 hex chars>"}]
NIGHTSHIFT_TOKENS=[]

# JSON array of CI systems allowed to report deploys (POST /events/deploy).
# These tokens work ONLY on /events/deploy, never on /mcp.
# Generate an entry with:  npm run token:new -- <source> ingest
# Example: [{"source":"github-actions","sha256":"<64 hex chars>"}]
NIGHTSHIFT_INGEST_TOKENS=[]

# Failed-auth limiter: after this many 401s from one IP inside the window,
# further requests from that IP get 429 until the window passes.
AUTH_FAIL_LIMIT=20
AUTH_FAIL_WINDOW_MINUTES=10

# ---------------------------------------------------------------------------
# Service catalog (Prometheus / Alertmanager / services / scan allowlist)
# ---------------------------------------------------------------------------

# Path to the YAML service catalog, relative to apps/server.
NIGHTSHIFT_CONFIG=config/nightshift.yaml

# Optional overrides for the URLs in the YAML (useful when deployed).
PROMETHEUS_URL=
ALERTMANAGER_URL=

# GitHub, read-only fine-grained token (never committed):
# - security checks (`security.repos` in the YAML): Metadata, Dependabot alerts, Secret scanning alerts
# - only if a service uses `deploys: { source: github }`: also Deployments and Contents
GITHUB_TOKEN=

# Admin API token for the demo-target executor (`executors.demo-admin.tokenEnv` in the YAML).
# Same value as DEMO_ADMIN_TOKEN in infra/.env. Each executor names its own env var.
DEMO_ADMIN_TOKEN=

# Public domain of this deployment (e.g. nightshift-demo.duckdns.org). When set, the
# security scan also checks TLS expiry and security headers of https://<domain>/healthz.
SECURITY_DOMAIN=

# ---------------------------------------------------------------------------
# Proactive alerts (Alertmanager webhook -> Telegram)
# ---------------------------------------------------------------------------

# Bearer token Alertmanager sends to POST /webhooks/alertmanager (min 24 chars).
# Locally `npm run stack:up` creates it and fills this in. Unset = webhook answers 401.
ALERTMANAGER_WEBHOOK_TOKEN=

# Telegram bot from @BotFather, and the chat that receives alerts. Both unset = no pushes
# (a warning at startup). The bot token is never logged.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Override only for tests (a fake Telegram endpoint).
TELEGRAM_API_URL=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by the running server. Required (audit log).
# On Neon use the POOLED string (host contains "-pooler"), e.g.
# postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require
DATABASE_URL=

# Direct (non-pooled) connection string, used only by `prisma migrate`.
# On Neon: the same string without "-pooler" in the host. Falls back to DATABASE_URL.
DIRECT_URL=
