// Nightshift database schema (PostgreSQL). Fields are minimal on purpose;
// extend them as features land. Generated client: src/generated/prisma (gitignored).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// One row per tool call (invariant 7). Never store raw input: only its hash.
model AuditLog {
  id        String   @id @default(uuid())
  actor     String
  role      String // viewer | responder
  tool      String
  inputHash String // sha256 of canonical JSON input
  outcome   String // ok | forbidden | error | ...
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([actor, createdAt])
  @@map("audit_log")
}

/// Two-phase remediation (invariant 1): prepare_action creates it, confirm_action
/// claims it atomically (status pending → executing) and runs it at most once.
model PendingAction {
  id             String    @id @default(uuid())
  confirmationId String    @unique
  action         String // failover_provider | rollback_deploy | restart_service
  service        String    @default("")
  /// Fully resolved params (every choice made at prepare time).
  params         Json
  /// sha256 of canonical {action, service, params}; re-checked before executing.
  paramsHash     String    @default("")
  /// Blast radius shown to the user: changes, affected, undo, expectedEffect.
  summary        Json?
  createdBy      String
  sessionId      String?
  incidentId     String?
  status         String    @default("pending") // pending | executing | succeeded | failed | refused
  expiresAt      DateTime
  usedAt         DateTime?
  executedAt     DateTime?
  result         Json?
  verification   Json?
  createdAt      DateTime  @default(now())

  @@index([createdBy, usedAt])
  @@index([executedAt])
  @@map("pending_action")
}

/// Nightshift-side acknowledgement (Alertmanager has no ack). One per firing
/// instance: a re-fire (new startsAt) needs a new ack.
model AlertAck {
  id          String   @id @default(uuid())
  fingerprint String
  startsAt    DateTime
  alertname   String
  service     String?
  ackedBy     String
  ackedAt     DateTime @default(now())

  @@unique([fingerprint, startsAt])
  @@map("alert_ack")
}

/// Silences Nightshift created in Alertmanager (idempotency + history).
model AlertSilence {
  id              String   @id @default(uuid())
  fingerprint     String
  alertname       String
  silenceId       String // Alertmanager silence id
  durationMinutes Int
  createdBy       String
  endsAt          DateTime
  createdAt       DateTime @default(now())

  @@index([fingerprint, createdAt])
  @@map("alert_silence")
}

/// A deploy reported by a CI system (POST /events/deploy). GitHub deployments
/// are read live and not stored. Text fields are sanitized before insert; the
/// commit message is untrusted data (invariant 6) and is never interpreted.
model DeployEvent {
  id            String   @id @default(uuid())
  source        String // ingest token name, e.g. "github-actions"
  externalId    String // caller's id (idempotency key); generated when absent
  service       String
  environment   String
  version       String
  commitSha     String?
  commitMessage String?
  author        String?
  status        String   @default("success") // success | failure | in_progress
  deployedAt    DateTime
  createdAt     DateTime @default(now())

  @@unique([source, externalId])
  @@index([service, deployedAt])
  @@map("deploy_event")
}

/// One open incident per service; explain_incident reuses it across sessions.
model Incident {
  id           String          @id @default(uuid())
  title        String
  severity     String // critical | warning | info
  status       String          @default("open") // open | resolved
  service      String?
  /// Top cause id from the latest diagnosis (recent_deploy, provider_failure, ...).
  primaryCause String?
  openedAt     DateTime        @default(now())
  updatedAt    DateTime        @default(now()) @updatedAt
  resolvedAt   DateTime?
  events       IncidentEvent[]

  @@index([status, openedAt])
  @@index([service, status])
  @@map("incident")
}

model IncidentEvent {
  id         String   @id @default(uuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  kind       String // diagnosis | alert | ack | silence | note | action | deploy
  actor      String?
  message    String // server-authored; never untrusted text
  data       Json?
  createdAt  DateTime @default(now())

  @@index([incidentId, createdAt])
  @@map("incident_event")
}

model SecurityScan {
  id         String    @id @default(uuid())
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  score      Int? // 0-100
  grade      String? // A-F
  findings   Finding[]

  @@index([startedAt])
  @@map("security_scan")
}

model Finding {
  id        String       @id @default(uuid())
  scanId    String
  scan      SecurityScan @relation(fields: [scanId], references: [id], onDelete: Cascade)
  check     String // tls_expiry | security_headers | dependabot | secret_scanning | ...
  asset     String
  severity  String // critical | high | medium | low | info
  title     String
  detail    Json?
  createdAt DateTime     @default(now())

  @@index([scanId])
  @@map("finding")
}
