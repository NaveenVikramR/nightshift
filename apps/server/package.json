{
  "name": "@nightshift/server",
  "version": "0.1.0",
  "private": true,
  "description": "Nightshift MCP server (Streamable HTTP, MCP 2025-11-25).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "dev": "node scripts/build-ui.mjs && tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "node scripts/build-ui.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.ui.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "node ../../infra/scripts/stack-status.mjs --preflight && vitest run -c vitest.integration.config.ts",
    "seed": "tsx prisma/seed.ts",
    "token:new": "tsx scripts/new-token.ts",
    "build:ui": "node scripts/build-ui.mjs",
    "screenshots": "tsx scripts/screenshots.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/express": "2.0.2",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "express": "5.3.0",
    "pg": "8.23.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "esbuild": "0.28.2",
    "happy-dom": "21.0.3",
    "playwright": "1.64.1",
    "prisma": "7.10.0",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.4"
  }
}
